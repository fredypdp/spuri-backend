# Spuri Event Sourcing - Environment Variables

# Ambiente
ENV=development
PORT=8080

# JWT
JWT_SECRET=seu_segredo_super_secreto_mude_em_producao
JWT_EXPIRY_HOURS=24

# GenesisDB (PostgreSQL)
GENESISDB_HOST=localhost
GENESISDB_PORT=5432
GENESISDB_USER=genesis
GENESISDB_PASSWORD=genesis123
GENESISDB_NAME=spuri_genesis
GENESISDB_SSLMODE=disable

# Ou use DATABASE_URL (Railway)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Projeções
PROJECTION_POLL_INTERVAL=1s
PROJECTION_BATCH_SIZE=100

# Logs
LOG_LEVEL=info
