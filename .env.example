# ============================================
# SPURI API - VARIÁVEIS DE AMBIENTE
# ============================================

# Banco de Dados
DATABASE_URL=postgresql://user:password@host:5432/spuri_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=senha
DB_NAME=spuri_db
DB_SSLMODE=disable

# Servidor
PORT=8080
ENV=development

# JWT
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres
JWT_EXPIRY_HOURS=24

# 🔥 GOOGLE SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-do-gmail
FROM_EMAIL=spuriartipan@gmail.com
FROM_NAME=Spuri - Sistema Académico
EMAIL_SERVICE_URL=http://localhost:3001

# URL Base (para links nos emails)
BASE_URL=https://spuri-backend.onrender.com

# Lista separada por vírgula de origens permitidas (CORS)
ALLOWED_ORIGINS=http://localhost:3000,https://spuripainel.vercel.app

# =============================================================================
# RATE LIMITING
# =============================================================================

# Requisições por minuto (global)
RATE_LIMIT_GLOBAL=100

# Tentativas de login por minuto
RATE_LIMIT_LOGIN=5

# Envios de email por hora
RATE_LIMIT_EMAIL=2

# =============================================================================
# LOGGING
# =============================================================================

# Nível de log (debug, info, warn, error)
LOG_LEVEL=info

# Formato (json, text)
LOG_FORMAT=json

# =============================================================================
# FEATURES FLAGS
# =============================================================================

# Ativar web search
ENABLE_WEB_SEARCH=false

# Ativar email verification
ENABLE_EMAIL_VERIFICATION=true

# Ativar password recovery
ENABLE_PASSWORD_RECOVERY=true

# ============================================================================
# CONFIGURAÇÕES AMBIENTE - SPURI EVENT SOURCING
# ============================================================================

# 🔒 EMAIL (SMTP - Gmail/Google Workspace)
# ⚠️ IMPORTANTE: Sem estas variáveis, emails NÃO serão enviados
# O sistema continuará funcionando, mas sem verificação de email


# ============================================================================
# INSTRUÇÕES POSTGRESQL UTF-8
# ============================================================================

# Se criar banco manualmente, use:
# CREATE DATABASE spuri_db 
#   WITH ENCODING 'UTF8' 
#   LC_COLLATE='pt_BR.UTF-8' 
#   LC_CTYPE='pt_BR.UTF-8' 
#   TEMPLATE=template0;

# ============================================================================
# VERIFICAÇÃO DE CONFIGURAÇÃO
# ============================================================================

# Para verificar se UTF-8 está funcionando:
# psql -d spuri_db -c "SHOW client_encoding;"
# Deve retornar: UTF8

# Para verificar encoding do banco:
# psql -d spuri_db -c "SELECT pg_encoding_to_char(encoding) FROM pg_database WHERE datname = 'spuri_db';"
# Deve retornar: UTF8