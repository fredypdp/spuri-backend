# Banco de Dados
DATABASE_URL=postgresql://user:password@host:5432/spuri_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=senha
DB_NAME=spuri_db
DB_SSLMODE=disable

# Servidor
PORT=8080
ENV=development

# JWT
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres

# 🔥 GOOGLE SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app-do-gmail
FROM_EMAIL=noreply@spuri.ao
FROM_NAME=Spuri - Sistema Académico

# URL Base (para links nos emails)
BASE_URL=https://api.spuri.ao