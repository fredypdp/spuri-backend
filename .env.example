# .env.example
# ============================================
# SPURI API - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ============================================

# Banco de Dados
# Substitua pelos valores reais do seu banco (Neon, Supabase, etc.)
# Use DATABASE_URL para provedores gerenciados (Neon, Supabase, etc.).
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Alternativa ao DATABASE_URL: variáveis individuais de conexão.
# Usadas apenas quando DATABASE_URL não estiver definido.
DB_HOST=localhost
DB_PORT=5432
DB_USER=fredy
DB_PASSWORD=fredy123
DB_NAME=spuri_db
DB_SSLMODE=disable

# Servidor
PORT=8080
ENV=development          # ou production

# JWT
JWT_SECRET=seu_segredo_muito_forte_aqui
JWT_EXPIRY_HOURS=24

# 📧 EMAILJS (substituindo SMTP)
EMAILJS_SERVICE_ID=service_xxxxxxxx
EMAILJS_TEMPLATE_VERIFICATION=template_xxxxxxxx
EMAILJS_TEMPLATE_RESET=template_xxxxxxxx
# Opcional: template dedicado para boas-vindas de administradores.
# Se vazio, o backend reutiliza EMAILJS_TEMPLATE_RESET como fallback.
EMAILJS_TEMPLATE_ADMIN_WELCOME=template_xxxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL Base Backend (para logs internos)
BASE_URL=https://seu-backend.seu-dominio.com

# URL Frontend (para links nos emails)
FRONTEND_URL=https://seu-frontend.vercel.app

# Lista separada por vírgula de origens permitidas (CORS)
ALLOWED_ORIGINS=http://localhost:3000,https://seu-frontend.vercel.app

# =============================================================================
# ⚡ RATE LIMITING (CONFIGURÁVEL)
# =============================================================================

# Requisições por minuto (global) - Padrão: 100
RATE_LIMIT_GLOBAL=100

# Tentativas de login por minuto - Padrão: 5
RATE_LIMIT_LOGIN=5

# Envios de email por hora - Padrão: 2
RATE_LIMIT_EMAIL=2

# =============================================================================
# 📊 MONITORING
# =============================================================================

# Nível de log (debug, info, warn, error)
LOG_LEVEL=info

# Formato (json, text)
LOG_FORMAT=json

# =============================================================================
# 🎯 FEATURES FLAGS
# =============================================================================

# Ativar web search
ENABLE_WEB_SEARCH=false

# Ativar email verification
ENABLE_EMAIL_VERIFICATION=true

# Ativar password recovery
ENABLE_PASSWORD_RECOVERY=true
# ============================================
# Armazenamento de Arquivos (Google Drive)
# ============================================

# ID da pasta raiz gerenciada pelo Spuri no Google Drive.
# Todos os documentos são salvos dentro desta pasta em:
# {codigo_academia}/matriculas/matricula_{codigo_solicitacao}/
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Token OAuth Bearer com permissão para criar pastas, enviar PDFs,
# remover arquivos e consultar quota na API Google Drive v3.
# Em produção, gere/renove este token fora do repositório e injete por secret.
GOOGLE_DRIVE_ACCESS_TOKEN=

# Diretório local usado pelo fallback/ambiente de desenvolvimento.
GOOGLE_DRIVE_LOCAL_ROOT=data/google_drive_storage

# Estimativa local de quota. Use true apenas em desenvolvimento/testes sem Drive.
GOOGLE_DRIVE_QUOTA_LOCAL_ESTIMATE=false

# Opcional: informe um dos dois para sobrescrever a quota total usada na estimativa local.
# Se ambos ficarem vazios, o padrão local é 15 GB.
GOOGLE_DRIVE_QUOTA_TOTAL_BYTES=
GOOGLE_DRIVE_QUOTA_TOTAL_GB=15
