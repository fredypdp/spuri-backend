# .env.example
# ============================================
# SPURI API - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ============================================

# =============================================================================
# Servidor / Ambiente
# =============================================================================
PORT=8080
ENV=development # development, test ou production

# Lista separada por vírgula de origens permitidas (CORS).
ALLOWED_ORIGINS=http://localhost:3000,https://seu-frontend.vercel.app

# =============================================================================
# Banco de Dados
# =============================================================================
# Use DATABASE_URL para provedores gerenciados (Neon, Supabase, Aiven, etc.).
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Alternativa ao DATABASE_URL: variáveis individuais de conexão.
# Usadas apenas quando DATABASE_URL não estiver definido.
DB_HOST=localhost
DB_PORT=5432
DB_USER=fredy
DB_PASSWORD=fredy123
DB_NAME=spuri_db
DB_SSLMODE=disable

# Pool PostgreSQL (o backend normaliza valores acima destes limites seguros por instância).
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONN_MAX_IDLE_TIME_SECONDS=120
DB_HEALTH_TIMEOUT_SECONDS=3

# Opções para provedores/poolers como Neon/PgBouncer.
DB_ALLOW_POOLER=false
DB_FORCE_SINGLE_CONN=false

# Teste opcional de integridade de banco; deixe 0 fora de execuções dedicadas.
SPURI_RUN_DB_INTEGRITY_TESTS=0

# =============================================================================
# Segurança / JWT
# =============================================================================
JWT_SECRET=seu_segredo_muito_forte_aqui
JWT_EXPIRY_HOURS=24

# Chave obrigatória para criptografia de segredos financeiros em qualquer ambiente.
FINANCE_ENCRYPTION_KEY=troque-por-uma-chave-longa-aleatoria

# =============================================================================
# Financeiro / AppyPay
# =============================================================================
# A aplicação seleciona TEST/PROD automaticamente a partir de ENV.
# Versão da API AppyPay; não inclua URL nem segredos aqui.
APPYPAY_API_VERSION=v2.0

# =============================================================================
# EmailJS
# =============================================================================
EMAILJS_SERVICE_ID=service_xxxxxxxx
EMAILJS_TEMPLATE_VERIFICATION=template_xxxxxxxx
EMAILJS_TEMPLATE_RESET=template_xxxxxxxx
# Opcional: template dedicado para boas-vindas de administradores.
# Se vazio, o backend reutiliza EMAILJS_TEMPLATE_RESET como fallback.
EMAILJS_TEMPLATE_ADMIN_WELCOME=template_xxxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL Frontend (para links nos emails).
FRONTEND_URL=https://seu-frontend.vercel.app

# =============================================================================
# Armazenamento de Arquivos (Mega)
# =============================================================================
STORAGE_PROVIDER=mega
MEGA_EMAIL=conta@exemplo.com
MEGA_PASSWORD=senha-mega
MEGA_ROOT_FOLDER=spuri

# Desenvolvimento/testes locais sem Mega real:
# STORAGE_PROVIDER=local
MEGA_LOCAL_ROOT=data/mega_storage

# =============================================================================
# Variáveis legadas/documentais não lidas diretamente pelo backend atual
# =============================================================================
# URL Base Backend (para logs internos/documentação operacional).
BASE_URL=https://seu-backend.seu-dominio.com

# Rate limiting configurável documentado para operação.
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_EMAIL=2

# Monitoramento/logs documentados para operação.
LOG_LEVEL=info
LOG_FORMAT=json

# Feature flags documentadas.
ENABLE_WEB_SEARCH=false
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RECOVERY=true
